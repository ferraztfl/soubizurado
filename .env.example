DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://zxmqlkmhuflvjhohwuqq.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only provider key used by controlled import jobs.
QUEST_API_KEY="qk_..."

# Server-side media worker.
MEDIA_STORAGE_LOCAL_ROOT="./data-private/media-store"
MEDIA_STORAGE_BUCKET="question-media"
MEDIA_MAX_BYTES="26214400"

# Durable staging used by local-document providers before media workers run.
MEDIA_STAGING_LOCAL_ROOT="./data-private/media-staging"
SOUBIZURADO_ADMIN_EMAIL=

# Question classifier (server-only). Default: rule-based, no network.
CLASSIFIER_PROVIDER=rule-based
# For openai-compatible providers (OpenAI, Gemini OpenAI endpoint,
# OpenRouter, vLLM, Ollama). Question text is sent to this endpoint.
CLASSIFIER_API_BASE_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=
CLASSIFIER_PROVIDER_LABEL=
CLASSIFIER_TIMEOUT_MS=30000
# compact (default, prompt v3: no Detalhe level, short answer, ~half the
# tokens) or labelled (original v2 prompt).
CLASSIFIER_PROMPT_STYLE=compact
# Suggestions below this stay REVIEW_REQUIRED; classification:apply only
# applies COMPLETED suggestions at or above it.
CLASSIFIER_MIN_CONFIDENCE=0.8
# AI calls per minute. Empty = 4 (free tier); paid tier: e.g. 60 with
# CLASSIFIER_CONCURRENCY=4. Rules calls are not throttled.
CLASSIFIER_CONCURRENCY=1
# Spending guard per background run (/admin/classificacao). Prices in USD per
# million tokens from the provider pricing page (they change); without them
# only the call cap applies.
CLASSIFIER_MAX_AI_CALLS_PER_RUN=500
CLASSIFIER_RUN_BUDGET_USD=
CLASSIFIER_PRICE_INPUT_USD_PER_M=
CLASSIFIER_PRICE_OUTPUT_USD_PER_M=
CLASSIFIER_REQUESTS_PER_MINUTE=
# Pipeline (only with openai-compatible): rules first, AI as fallback.
# Rules answers at or above the threshold skip the AI. Confident results
# (>= CLASSIFIER_MIN_CONFIDENCE) are applied automatically; never published.
CLASSIFIER_LAYERED=true
CLASSIFIER_RULES_THRESHOLD=0.8
CLASSIFIER_AUTO_APPLY=true
# Optional local AI between the rules and the remote AI (Ollama). Must be
# localhost. Small CPU models are slow and overstate confidence, hence the
# stricter threshold; if it is offline the pipeline goes straight to remote.
# CLASSIFIER_LOCAL_API_BASE_URL=http://localhost:11434/v1
# CLASSIFIER_LOCAL_MODEL=qwen2.5:3b
# CLASSIFIER_LOCAL_THRESHOLD=0.9
# CLASSIFIER_LOCAL_TIMEOUT_MS=180000
# Example (Google AI Studio free tier):
# CLASSIFIER_PROVIDER=openai-compatible
# CLASSIFIER_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CLASSIFIER_MODEL=<gemini flash model id from AI Studio>
# CLASSIFIER_PROVIDER_LABEL=gemini
# CLASSIFIER_REQUESTS_PER_MINUTE=8

# Media storage (server only).
# "local" = data-private/media-store (dev); "supabase" = private Supabase Storage bucket.
MEDIA_STORAGE_DRIVER=local
SUPABASE_MEDIA_BUCKET=question-media
# Supabase secret key (sb_secret_..., successor of service_role). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
