DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://zxmqlkmhuflvjhohwuqq.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only provider key used by controlled import jobs.
QUEST_API_KEY="qk_..."

# Server-side media worker.
MEDIA_STORAGE_LOCAL_ROOT="./data-private/media-store"
MEDIA_STORAGE_BUCKET="question-media"
MEDIA_MAX_BYTES="26214400"

# Durable staging used by local-document providers before media workers run.
MEDIA_STAGING_LOCAL_ROOT="./data-private/media-staging"
SOUBIZURADO_ADMIN_EMAIL=

# Question classifier (server-only). Default: rule-based, no network.
CLASSIFIER_PROVIDER=rule-based
# For openai-compatible providers (OpenAI, Gemini OpenAI endpoint,
# OpenRouter, vLLM, Ollama). Question text is sent to this endpoint.
CLASSIFIER_API_BASE_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=
CLASSIFIER_PROVIDER_LABEL=
CLASSIFIER_TIMEOUT_MS=30000
# Suggestions below this stay REVIEW_REQUIRED; classification:apply only
# applies COMPLETED suggestions at or above it.
CLASSIFIER_MIN_CONFIDENCE=0.8
# Throttle provider calls (free tiers). Empty = no throttle.
CLASSIFIER_REQUESTS_PER_MINUTE=
# Example (Google AI Studio free tier):
# CLASSIFIER_PROVIDER=openai-compatible
# CLASSIFIER_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CLASSIFIER_MODEL=<gemini flash model id from AI Studio>
# CLASSIFIER_PROVIDER_LABEL=gemini
# CLASSIFIER_REQUESTS_PER_MINUTE=8

# Media storage (server only).
# "local" = data-private/media-store (dev); "supabase" = private Supabase Storage bucket.
MEDIA_STORAGE_DRIVER=local
SUPABASE_MEDIA_BUCKET=question-media
# Supabase secret key (sb_secret_..., successor of service_role). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
