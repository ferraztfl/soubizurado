generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  STUDENT
  EDITOR
  MODERATOR
  ADMIN
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum QuestionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum QuestionAnswerKeyStatus {
  MISSING
  DEFINED
  VERIFIED
}

enum QuestionSourceType {
  OFFICIAL_EXAM
  PROVIDER_API
  ORIGINAL
  LICENSED
  OTHER
}

enum QuestionLicenseStatus {
  UNKNOWN
  PUBLIC_DOMAIN
  AUTHORIZED
  LICENSED
  RESTRICTED
}

enum TaxonomyAliasSource {
  SEED
  MANUAL
  IMPORT
}

enum QuestionClassificationStatus {
  PENDING
  PROCESSING
  COMPLETED
  REVIEW_REQUIRED
  FAILED
}

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum ImportItemStatus {
  RECEIVED
  IMPORTED
  DUPLICATE
  REVIEW_REQUIRED
  FAILED
}

enum ImportMediaTaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  authUserId  String   @unique @map("auth_user_id") @db.Uuid
  displayName String?  @map("display_name") @db.VarChar(120)
  avatarUrl   String?  @map("avatar_url") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles                  UserRole[]
  studyAnswerAttempts    StudyAnswerAttempt[]
  studyFavorites         StudyFavorite[]
  taxonomyRevisions      TaxonomyRevision[]
  appliedClassifications QuestionClassificationTask[]
  questionRevisions      QuestionRevision[]
  studyQuestionNotes     StudyQuestionNote[]
  reportedQuestionErrors QuestionErrorReport[]        @relation("QuestionErrorReportReporter")
  resolvedQuestionErrors QuestionErrorReport[]        @relation("QuestionErrorReportResolver")
  studySimulations       StudySimulation[]
  adminActions           AdminAuditLog[]              @relation("AdminAuditActor")
  adminActionsReceived   AdminAuditLog[]              @relation("AdminAuditTarget")
  studyPreference        StudyPreference?
  studyReviewItems       StudyReviewItem[]
  studySessions          StudySession[]
  entitlements           Entitlement[]                @relation("EntitlementOwner")
  grantedEntitlements    Entitlement[]                @relation("EntitlementGrantor")
  orders                 Order[]
  lessonProgress         CourseLessonProgress[]
  blogPosts              BlogPost[]
  subscriptions          Subscription[]
  syllabusProgress       StudySyllabusProgress[]
  lessonAnnotations      CourseLessonAnnotation[]
  courseReadingStates    CourseReadingState[]

  @@map("profiles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, role])
  @@index([role])
  @@map("user_roles")
}

/// Broad knowledge area (ENEM/BNCC), e.g. "Ciências Humanas e suas
/// Tecnologias". Groups disciplines; it is not a level of the
/// Discipline -> Area -> Topic -> Subtopic hierarchy.
model KnowledgeArea {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(160)
  slug        String   @unique @db.VarChar(180)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  disciplines Discipline[]
  questions   Question[]

  @@index([isActive, sortOrder])
  @@map("knowledge_areas")
}

model Discipline {
  id              String   @id @default(uuid()) @db.Uuid
  knowledgeAreaId String?  @map("knowledge_area_id") @db.Uuid
  name            String   @db.VarChar(160)
  slug            String   @unique @db.VarChar(180)
  description     String?  @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  knowledgeArea KnowledgeArea? @relation(fields: [knowledgeAreaId], references: [id], onDelete: Restrict)

  areas     Area[]
  topics    Topic[]
  questions Question[]
  aliases   DisciplineAlias[]

  classificationSuggestions QuestionClassificationTask[]
  contestSyllabusSubjects   ContestSyllabusSubject[]

  @@index([isActive, sortOrder])
  @@index([knowledgeAreaId, isActive, sortOrder])
  @@map("disciplines")
}

model Area {
  id           String   @id @default(uuid()) @db.Uuid
  disciplineId String   @map("discipline_id") @db.Uuid
  name         String   @db.VarChar(160)
  slug         String   @db.VarChar(180)
  description  String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict)

  topics    Topic[]
  questions Question[]
  aliases   AreaAlias[]

  classificationSuggestions QuestionClassificationTask[]
  contestSyllabusSubjects   ContestSyllabusSubject[]

  @@unique([disciplineId, slug])
  @@unique([id, disciplineId])
  @@index([disciplineId, isActive, sortOrder])
  @@map("areas")
}

model Topic {
  id           String   @id @default(uuid()) @db.Uuid
  disciplineId String   @map("discipline_id") @db.Uuid
  areaId       String?  @map("area_id") @db.Uuid
  name         String   @db.VarChar(180)
  slug         String   @db.VarChar(200)
  description  String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  area       Area?      @relation(fields: [areaId, disciplineId], references: [id, disciplineId], onDelete: Restrict, onUpdate: Restrict)

  subtopics Subtopic[]
  questions Question[]
  aliases   TopicAlias[]

  classificationSuggestions QuestionClassificationTask[]
  contestSyllabusSubjects   ContestSyllabusSubject[]

  @@unique([disciplineId, slug])
  @@unique([id, disciplineId])
  @@index([disciplineId, isActive, sortOrder])
  @@index([areaId, isActive, sortOrder])
  @@map("topics")
}

model Subtopic {
  id          String   @id @default(uuid()) @db.Uuid
  topicId     String   @map("topic_id") @db.Uuid
  name        String   @db.VarChar(180)
  slug        String   @db.VarChar(200)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  questions Question[]
  aliases   SubtopicAlias[]

  classificationSuggestions QuestionClassificationTask[]

  @@unique([topicId, slug])
  @@unique([id, topicId])
  @@index([topicId, isActive, sortOrder])
  @@map("subtopics")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  questionTags QuestionTag[]

  @@index([isActive])
  @@map("tags")
}

/// Alternative name resolving to one canonical discipline.
/// normalizedName comes from normalizeTaxonomyTerm and is globally
/// unique, like Discipline.slug.
model DisciplineAlias {
  id             String              @id @default(uuid()) @db.Uuid
  disciplineId   String              @map("discipline_id") @db.Uuid
  name           String              @db.VarChar(180)
  normalizedName String              @unique @map("normalized_name") @db.VarChar(200)
  source         TaxonomyAliasSource @default(MANUAL)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@index([disciplineId])
  @@map("discipline_aliases")
}

/// Alias scoped to the owning discipline; the composite key guarantees
/// disciplineId always matches the area discipline.
model AreaAlias {
  id             String              @id @default(uuid()) @db.Uuid
  areaId         String              @map("area_id") @db.Uuid
  disciplineId   String              @map("discipline_id") @db.Uuid
  name           String              @db.VarChar(180)
  normalizedName String              @map("normalized_name") @db.VarChar(200)
  source         TaxonomyAliasSource @default(MANUAL)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  area Area @relation(fields: [areaId, disciplineId], references: [id, disciplineId], onDelete: Cascade)

  @@unique([disciplineId, normalizedName])
  @@index([areaId])
  @@map("area_aliases")
}

model TopicAlias {
  id             String              @id @default(uuid()) @db.Uuid
  topicId        String              @map("topic_id") @db.Uuid
  disciplineId   String              @map("discipline_id") @db.Uuid
  name           String              @db.VarChar(180)
  normalizedName String              @map("normalized_name") @db.VarChar(200)
  source         TaxonomyAliasSource @default(MANUAL)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  topic Topic @relation(fields: [topicId, disciplineId], references: [id, disciplineId], onDelete: Cascade)

  @@unique([disciplineId, normalizedName])
  @@index([topicId])
  @@map("topic_aliases")
}

model SubtopicAlias {
  id             String              @id @default(uuid()) @db.Uuid
  subtopicId     String              @map("subtopic_id") @db.Uuid
  topicId        String              @map("topic_id") @db.Uuid
  name           String              @db.VarChar(180)
  normalizedName String              @map("normalized_name") @db.VarChar(200)
  source         TaxonomyAliasSource @default(MANUAL)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  subtopic Subtopic @relation(fields: [subtopicId, topicId], references: [id, topicId], onDelete: Cascade)

  @@unique([topicId, normalizedName])
  @@index([subtopicId])
  @@map("subtopic_aliases")
}

/// Monotonic taxonomy version. Classification results record the
/// version they were produced against.
model TaxonomyRevision {
  id                 String   @id @default(uuid()) @db.Uuid
  version            Int      @unique
  summary            String   @db.Text
  createdByProfileId String?  @map("created_by_profile_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy Profile? @relation(fields: [createdByProfileId], references: [id], onDelete: SetNull)

  @@map("taxonomy_revisions")
}

model ExaminingBoard {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(180)
  acronym    String?  @db.VarChar(40)
  slug       String   @unique @db.VarChar(200)
  websiteUrl String?  @map("website_url") @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  examinations Examination[]
  targetedBy   StudyPreference[]
  blogPosts    BlogPost[]
  contests     Contest[]

  @@index([isActive, name])
  @@map("examining_boards")
}

model PublicOrganization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  acronym   String?  @db.VarChar(40)
  slug      String   @unique @db.VarChar(220)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  examinations Examination[]
  contests     Contest[]

  @@index([isActive, name])
  @@map("public_organizations")
}

model CareerPosition {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(180)
  slug        String   @unique @db.VarChar(200)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  examinations Examination[]

  @@index([isActive, name])
  @@map("career_positions")
}

model Examination {
  id               String    @id @default(uuid()) @db.Uuid
  boardId          String?   @map("board_id") @db.Uuid
  organizationId   String?   @map("organization_id") @db.Uuid
  careerPositionId String?   @map("career_position_id") @db.Uuid
  title            String    @db.VarChar(240)
  slug             String    @unique @db.VarChar(260)
  year             Int?      @db.SmallInt
  stateCode        String?   @map("state_code") @db.Char(2)
  noticeNumber     String?   @map("notice_number") @db.VarChar(80)
  examDate         DateTime? @map("exam_date") @db.Date
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  board          ExaminingBoard?     @relation(fields: [boardId], references: [id], onDelete: Restrict)
  organization   PublicOrganization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  careerPosition CareerPosition?     @relation(fields: [careerPositionId], references: [id], onDelete: Restrict)

  questions   Question[]
  occurrences QuestionOccurrence[]

  @@index([boardId, year])
  @@index([organizationId, year])
  @@index([careerPositionId, year])
  @@index([isActive, year])
  @@map("examinations")
}

model QuestionSource {
  id            String                @id @default(uuid()) @db.Uuid
  sourceType    QuestionSourceType    @map("source_type")
  name          String                @db.VarChar(200)
  reference     String?               @unique @db.VarChar(250)
  url           String?               @db.Text
  licenseStatus QuestionLicenseStatus @default(UNKNOWN) @map("license_status")
  licenseName   String?               @map("license_name") @db.VarChar(160)
  licenseNotes  String?               @map("license_notes") @db.Text
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  questions   Question[]
  occurrences QuestionOccurrence[]
  importJobs  ImportJob[]

  @@index([sourceType, licenseStatus])
  @@map("question_sources")
}

model Question {
  id                   String                  @id @default(uuid()) @db.Uuid
  /// Short public code shown as "Q" + number (e.g. Q100001).
  publicNumber         Int                     @unique @default(autoincrement()) @map("public_number")
  type                 QuestionType
  status               QuestionStatus          @default(DRAFT)
  answerKeyStatus      QuestionAnswerKeyStatus @default(MISSING) @map("answer_key_status")
  statement            String                  @db.Text
  contentHash          String?                 @map("content_hash") @db.Char(64)
  canonicalFingerprint String?                 @unique @map("canonical_fingerprint") @db.Char(64)
  normalizationVersion Int                     @default(1) @map("normalization_version")
  correctTrueFalse     Boolean?                @map("correct_true_false")
  sourceId             String?                 @map("source_id") @db.Uuid
  examinationId        String?                 @map("examination_id") @db.Uuid
  knowledgeAreaId      String?                 @map("knowledge_area_id") @db.Uuid
  disciplineId         String?                 @map("discipline_id") @db.Uuid
  areaId               String?                 @map("area_id") @db.Uuid
  topicId              String?                 @map("topic_id") @db.Uuid
  subtopicId           String?                 @map("subtopic_id") @db.Uuid
  publishedAt          DateTime?               @map("published_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  source        QuestionSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  examination   Examination?    @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  knowledgeArea KnowledgeArea?  @relation(fields: [knowledgeAreaId], references: [id], onDelete: Restrict)
  discipline    Discipline?     @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  /// Composite keys keep area/topic inside the question discipline and
  /// the subtopic inside the question topic at the database level.
  area          Area?           @relation(fields: [areaId, disciplineId], references: [id, disciplineId], onDelete: Restrict, onUpdate: Restrict)
  topic         Topic?          @relation(fields: [topicId, disciplineId], references: [id, disciplineId], onDelete: Restrict, onUpdate: Restrict)
  subtopic      Subtopic?       @relation(fields: [subtopicId, topicId], references: [id, topicId], onDelete: Restrict, onUpdate: Restrict)

  alternatives        QuestionAlternative[]
  explanation         QuestionExplanation?
  questionTags        QuestionTag[]
  supportLinks        QuestionSupportLink[]
  occurrences         QuestionOccurrence[]
  importItems         ImportItem[]
  duplicateCandidates ImportDuplicateCandidate[] @relation("ImportDuplicateCandidateQuestion")
  studyAnswerAttempts StudyAnswerAttempt[]
  studyFavorites      StudyFavorite[]

  mediaLinks QuestionMediaLink[]
  mediaTasks ImportMediaTask[]

  classificationTasks QuestionClassificationTask[]
  revisions           QuestionRevision[]
  studyNotes          StudyQuestionNote[]
  errorReports        QuestionErrorReport[]
  simulationQuestions StudySimulationQuestion[]

  studyReviewItems      StudyReviewItem[]
  studySessionQuestions StudySessionQuestion[]
  courseLessonQuestions CourseLessonQuestion[]

  @@index([status, type])
  @@index([status, disciplineId])
  @@index([status, topicId])
  @@index([status, subtopicId])
  @@index([status, examinationId])
  @@index([status, knowledgeAreaId])
  @@index([sourceId])
  @@index([contentHash])
  @@map("questions")
}

model QuestionAlternative {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  label      String   @db.VarChar(8)
  content    String   @db.Text
  position   Int
  isCorrect  Boolean  @default(false) @map("is_correct")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  studyAnswerAttempts StudyAnswerAttempt[]           @relation("StudyAttemptSelectedAlternative")
  mediaLinks          QuestionAlternativeMediaLink[]

  @@unique([questionId, label])
  @@unique([questionId, position])
  @@index([questionId, isCorrect])
  @@map("question_alternatives")
}

model QuestionExplanation {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @unique @map("question_id") @db.Uuid
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_explanations")
}

model QuestionTag {
  questionId String   @map("question_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId, questionId])
  @@map("question_tags")
}

model QuestionSupportContent {
  id          String   @id @default(uuid()) @db.Uuid
  content     String   @db.Text
  contentHash String   @unique @map("content_hash") @db.Char(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  questionLinks QuestionSupportLink[]

  @@map("question_support_contents")
}

model QuestionSupportLink {
  questionId       String @map("question_id") @db.Uuid
  supportContentId String @map("support_content_id") @db.Uuid
  position         Int

  question       Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  supportContent QuestionSupportContent @relation(fields: [supportContentId], references: [id], onDelete: Cascade)

  @@id([questionId, supportContentId])
  @@unique([questionId, position])
  @@index([supportContentId, questionId])
  @@map("question_support_links")
}

model QuestionOccurrence {
  id                     String   @id @default(uuid()) @db.Uuid
  questionId             String   @map("question_id") @db.Uuid
  sourceId               String   @map("source_id") @db.Uuid
  examinationId          String?  @map("examination_id") @db.Uuid
  externalId             String   @map("external_id") @db.VarChar(180)
  externalQuestionNumber String?  @map("external_question_number") @db.VarChar(60)
  externalExaminationId  String?  @map("external_examination_id") @db.VarChar(180)
  sourceUrl              String?  @map("source_url") @db.Text
  capturedAt             DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  question    Question       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  source      QuestionSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  examination Examination?   @relation(fields: [examinationId], references: [id], onDelete: Restrict)

  @@unique([sourceId, externalId])
  @@index([questionId, capturedAt])
  @@index([examinationId])
  @@index([sourceId, externalExaminationId])
  @@map("question_occurrences")
}

/// Persistent, auditable classification queue. Each task stores the
/// provider output (rawResult) and the suggestion resolved to canonical
/// taxonomy ids by the backend. Suggestions are never applied to the
/// question automatically; appliedAt records a reviewer applying one.
model QuestionClassificationTask {
  id                    String                       @id @default(uuid()) @db.Uuid
  questionId            String                       @map("question_id") @db.Uuid
  status                QuestionClassificationStatus @default(PENDING)
  attempts              Int                          @default(0)
  nextAttemptAt         DateTime?                    @map("next_attempt_at") @db.Timestamptz(6)
  provider              String                       @db.VarChar(60)
  model                 String?                      @db.VarChar(120)
  classifierVersion     String                       @map("classifier_version") @db.VarChar(40)
  taxonomyVersion       Int                          @map("taxonomy_version")
  confidence            Decimal?                     @db.Decimal(5, 4)
  suggestedDisciplineId String?                      @map("suggested_discipline_id") @db.Uuid
  suggestedAreaId       String?                      @map("suggested_area_id") @db.Uuid
  suggestedTopicId      String?                      @map("suggested_topic_id") @db.Uuid
  suggestedSubtopicId   String?                      @map("suggested_subtopic_id") @db.Uuid
  suggestedTags         String[]                     @default([]) @map("suggested_tags") @db.VarChar(120)
  rawResult             Json?                        @map("raw_result")
  errorMessage          String?                      @map("error_message") @db.Text
  completedAt           DateTime?                    @map("completed_at") @db.Timestamptz(6)
  appliedAt             DateTime?                    @map("applied_at") @db.Timestamptz(6)
  appliedByProfileId    String?                      @map("applied_by_profile_id") @db.Uuid
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  question            Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  suggestedDiscipline Discipline? @relation(fields: [suggestedDisciplineId], references: [id], onDelete: Restrict)
  suggestedArea       Area?       @relation(fields: [suggestedAreaId], references: [id], onDelete: Restrict)
  suggestedTopic      Topic?      @relation(fields: [suggestedTopicId], references: [id], onDelete: Restrict)
  suggestedSubtopic   Subtopic?   @relation(fields: [suggestedSubtopicId], references: [id], onDelete: Restrict)
  appliedBy           Profile?    @relation(fields: [appliedByProfileId], references: [id], onDelete: SetNull)

  @@unique([questionId, classifierVersion, taxonomyVersion])
  @@index([status, nextAttemptAt, createdAt])
  @@index([questionId, createdAt])
  @@index([suggestedDisciplineId])
  @@index([suggestedTopicId])
  @@map("question_classification_tasks")
}

model ImportJob {
  id             String          @id @default(uuid()) @db.Uuid
  sourceId       String          @map("source_id") @db.Uuid
  provider       String          @db.VarChar(80)
  status         ImportJobStatus @default(PENDING)
  cursorStart    String?         @map("cursor_start") @db.VarChar(200)
  cursorEnd      String?         @map("cursor_end") @db.VarChar(200)
  requestedLimit Int?            @map("requested_limit")
  receivedCount  Int             @default(0) @map("received_count")
  importedCount  Int             @default(0) @map("imported_count")
  duplicateCount Int             @default(0) @map("duplicate_count")
  reviewCount    Int             @default(0) @map("review_count")
  failedCount    Int             @default(0) @map("failed_count")
  errorMessage   String?         @map("error_message") @db.Text
  startedAt      DateTime?       @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?       @map("finished_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  source QuestionSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  items  ImportItem[]

  @@index([sourceId, createdAt])
  @@index([status, createdAt])
  @@map("import_jobs")
}

model ImportItem {
  id            String           @id @default(uuid()) @db.Uuid
  jobId         String           @map("job_id") @db.Uuid
  externalId    String           @map("external_id") @db.VarChar(180)
  status        ImportItemStatus @default(RECEIVED)
  rawPayload    Json             @map("raw_payload")
  payloadHash   String           @map("payload_hash") @db.Char(64)
  questionId    String?          @map("question_id") @db.Uuid
  failureReason String?          @map("failure_reason") @db.Text
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  job                 ImportJob                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  question            Question?                  @relation(fields: [questionId], references: [id], onDelete: Restrict)
  duplicateCandidates ImportDuplicateCandidate[]
  mediaLinks          ImportItemMediaLink[]

  mediaTasks ImportMediaTask[]

  @@unique([jobId, externalId])
  @@index([questionId])
  @@index([status, createdAt])
  @@map("import_items")
}

model ImportDuplicateCandidate {
  id                  String   @id @default(uuid()) @db.Uuid
  importItemId        String   @map("import_item_id") @db.Uuid
  candidateQuestionId String   @map("candidate_question_id") @db.Uuid
  similarity          Decimal  @db.Decimal(5, 4)
  reason              String   @db.VarChar(120)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  importItem        ImportItem @relation(fields: [importItemId], references: [id], onDelete: Cascade)
  candidateQuestion Question   @relation("ImportDuplicateCandidateQuestion", fields: [candidateQuestionId], references: [id], onDelete: Restrict)

  @@unique([importItemId, candidateQuestionId])
  @@index([candidateQuestionId, similarity])
  @@map("import_duplicate_candidates")
}

model ImportMediaTask {
  id               String                @id @default(uuid()) @db.Uuid
  importItemId     String                @map("import_item_id") @db.Uuid
  questionId       String?               @map("question_id") @db.Uuid
  mediaAssetId     String?               @map("media_asset_id") @db.Uuid
  sourceUrl        String                @map("source_url") @db.Text
  role             String                @db.VarChar(40)
  alternativeLabel String                @default("") @map("alternative_label") @db.VarChar(8)
  position         Int
  status           ImportMediaTaskStatus @default(PENDING)
  attempts         Int                   @default(0)
  errorMessage     String?               @map("error_message") @db.Text
  nextAttemptAt    DateTime?             @map("next_attempt_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  importItem ImportItem  @relation(fields: [importItemId], references: [id], onDelete: Cascade)
  question   Question?   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([importItemId, role, alternativeLabel, position])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@index([questionId])
  @@index([mediaAssetId])
  @@map("import_media_tasks")
}

model MediaAsset {
  id              String   @id @default(uuid()) @db.Uuid
  storageProvider String   @map("storage_provider") @db.VarChar(40)
  bucket          String   @db.VarChar(160)
  storageKey      String   @unique @map("storage_key") @db.VarChar(700)
  mimeType        String   @map("mime_type") @db.VarChar(160)
  sizeBytes       BigInt   @map("size_bytes") @db.BigInt
  width           Int?
  height          Int?
  altText         String?  @map("alt_text") @db.Text
  checksum        String   @unique @db.Char(64)
  sourceUrl       String?  @map("source_url") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  importItemLinks          ImportItemMediaLink[]
  questionLinks            QuestionMediaLink[]
  questionAlternativeLinks QuestionAlternativeMediaLink[]

  ingestionTasks ImportMediaTask[]
  courseCovers   Course[]
  lessonPdfs     CourseLesson[]
  blogCovers     BlogPost[]
  blogImages     BlogPostImage[]
  offerBanners   Offer[]
  contestLogos   Contest[]

  @@index([storageProvider, bucket])
  @@index([mimeType])
  @@map("media_assets")
}

model ImportItemMediaLink {
  id               String   @id @default(uuid()) @db.Uuid
  importItemId     String   @map("import_item_id") @db.Uuid
  mediaAssetId     String   @map("media_asset_id") @db.Uuid
  role             String   @db.VarChar(40)
  alternativeLabel String   @default("") @map("alternative_label") @db.VarChar(8)
  position         Int
  page             Int?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  importItem ImportItem @relation(fields: [importItemId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([importItemId, mediaAssetId, role, alternativeLabel, position], map: "import_item_media_links_item_asset_role_alt_position_key")
  @@index([importItemId, role, position])
  @@index([mediaAssetId])
  @@map("import_item_media_links")
}

model QuestionMediaLink {
  id           String   @id @default(uuid()) @db.Uuid
  questionId   String   @map("question_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  role         String   @db.VarChar(40)
  position     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([questionId, role, position])
  @@index([mediaAssetId])
  @@map("question_media_links")
}

model QuestionAlternativeMediaLink {
  id            String   @id @default(uuid()) @db.Uuid
  alternativeId String   @map("alternative_id") @db.Uuid
  mediaAssetId  String   @map("media_asset_id") @db.Uuid
  position      Int
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  alternative QuestionAlternative @relation(fields: [alternativeId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset          @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([alternativeId, position])
  @@index([mediaAssetId])
  @@map("question_alternative_media_links")
}

model StudyAnswerAttempt {
  id                    String       @id @default(uuid()) @db.Uuid
  profileId             String       @map("profile_id") @db.Uuid
  questionId            String       @map("question_id") @db.Uuid
  questionType          QuestionType @map("question_type")
  selectedAlternativeId String?      @map("selected_alternative_id") @db.Uuid
  selectedTrueFalse     Boolean?     @map("selected_true_false")
  isCorrect             Boolean      @map("is_correct")
  responseTimeMs        Int?         @map("response_time_ms")
  answeredAt            DateTime     @default(now()) @map("answered_at") @db.Timestamptz(6)

  profile             Profile              @relation(fields: [profileId], references: [id], onDelete: Restrict)
  question            Question             @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedAlternative QuestionAlternative? @relation("StudyAttemptSelectedAlternative", fields: [selectedAlternativeId], references: [id], onDelete: Restrict)

  @@index([profileId, answeredAt])
  @@index([profileId, questionId, answeredAt])
  @@index([profileId, isCorrect, answeredAt])
  @@index([questionId, answeredAt])
  @@index([selectedAlternativeId])
  /// Period-wide aggregations (ranking) without scanning every answer ever.
  @@index([answeredAt])
  @@map("study_answer_attempts")
}

model StudyFavorite {
  profileId  String   @map("profile_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([profileId, questionId])
  @@index([profileId, createdAt])
  @@index([questionId, profileId])
  @@map("study_favorites")
}

/// Audit trail of manual edits made in the backoffice. Snapshots hold
/// the edited fields before and after the change.
model QuestionRevision {
  id               String         @id @default(uuid()) @db.Uuid
  questionId       String         @map("question_id") @db.Uuid
  editorProfileId  String?        @map("editor_profile_id") @db.Uuid
  reason           String         @db.VarChar(500)
  changedFields    String[]       @map("changed_fields") @db.VarChar(60)
  answerKeyChanged Boolean        @default(false) @map("answer_key_changed")
  questionStatus   QuestionStatus @map("question_status")
  before           Json
  after            Json
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  editor   Profile? @relation(fields: [editorProfileId], references: [id], onDelete: SetNull)

  @@index([questionId, createdAt])
  @@index([answerKeyChanged, createdAt])
  @@map("question_revisions")
}

/// A student's private note on a question (one per student and question).
model StudyQuestionNote {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String   @map("profile_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  content    String   @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([profileId, questionId])
  @@index([questionId])
  @@map("study_question_notes")
}

/// "Reportar erro": a student points out a problem in a published question.
/// reason / status values are enforced by CHECK constraints in the migration.
model QuestionErrorReport {
  id                String    @id @default(uuid()) @db.Uuid
  questionId        String    @map("question_id") @db.Uuid
  reporterProfileId String?   @map("reporter_profile_id") @db.Uuid
  reason            String    @db.VarChar(40)
  details           String?   @db.VarChar(1000)
  status            String    @default("OPEN") @db.VarChar(20)
  resolutionNote    String?   @map("resolution_note") @db.VarChar(500)
  resolverProfileId String?   @map("resolver_profile_id") @db.Uuid
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reporter Profile? @relation("QuestionErrorReportReporter", fields: [reporterProfileId], references: [id], onDelete: SetNull)
  resolver Profile? @relation("QuestionErrorReportResolver", fields: [resolverProfileId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([questionId, status])
  @@map("question_error_reports")
}

/// A timed practice exam built from explorer filters ("Simulados").
/// status: IN_PROGRESS | FINISHED (CHECK constraint in the migration).
model StudySimulation {
  id               String    @id @default(uuid()) @db.Uuid
  profileId        String    @map("profile_id") @db.Uuid
  title            String    @db.VarChar(160)
  filters          Json
  questionCount    Int       @map("question_count")
  timeLimitMinutes Int?      @map("time_limit_minutes")
  status           String    @default("IN_PROGRESS") @db.VarChar(20)
  correctCount     Int?      @map("correct_count")
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)

  profile   Profile                   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  questions StudySimulationQuestion[]

  @@index([profileId, startedAt])
  @@map("study_simulations")
}

/// One question of a simulation, with the answer chosen during the exam.
model StudySimulationQuestion {
  id                    String   @id @default(uuid()) @db.Uuid
  simulationId          String   @map("simulation_id") @db.Uuid
  questionId            String   @map("question_id") @db.Uuid
  position              Int
  selectedAlternativeId String?  @map("selected_alternative_id") @db.Uuid
  selectedTrueFalse     Boolean? @map("selected_true_false")
  isCorrect             Boolean? @map("is_correct")
  attemptId             String?  @map("attempt_id") @db.Uuid

  simulation StudySimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([simulationId, position])
  @@unique([simulationId, questionId])
  @@index([questionId])
  @@map("study_simulation_questions")
}

/// Sensitive backoffice actions on accounts (invite, role change, block).
/// Written only server-side after requireAdminUser; RLS on, no policies.
model AdminAuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  actorProfileId   String?  @map("actor_profile_id") @db.Uuid
  action           String   @db.VarChar(60)
  targetProfileId  String?  @map("target_profile_id") @db.Uuid
  targetAuthUserId String?  @map("target_auth_user_id") @db.Uuid
  details          Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor  Profile? @relation("AdminAuditActor", fields: [actorProfileId], references: [id], onDelete: SetNull)
  target Profile? @relation("AdminAuditTarget", fields: [targetProfileId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetProfileId, createdAt])
  @@map("admin_audit_logs")
}

/// A student's study goals and privacy choices (one row per profile).
model StudyPreference {
  profileId      String    @id @map("profile_id") @db.Uuid
  dailyGoal      Int       @default(20) @map("daily_goal") @db.SmallInt
  targetExam     String?   @map("target_exam") @db.VarChar(180)
  targetBoardId  String?   @map("target_board_id") @db.Uuid
  targetExamDate DateTime? @map("target_exam_date") @db.Date
  showInRanking  Boolean   @default(true) @map("show_in_ranking")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile     Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  targetBoard ExaminingBoard? @relation(fields: [targetBoardId], references: [id], onDelete: SetNull)

  @@map("study_preferences")
}

/// Spaced review of a question the student got wrong (see spaced-review.ts).
model StudyReviewItem {
  profileId      String   @map("profile_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  step           Int      @default(0) @db.SmallInt
  dueOn          DateTime @map("due_on") @db.Date
  lapses         Int      @default(1)
  lastAnsweredAt DateTime @map("last_answered_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([profileId, questionId])
  @@index([profileId, dueOn])
  @@map("study_review_items")
}

/// A guided study session ("Estudar"): a fixed list of questions answered with immediate feedback.
model StudySession {
  id            String    @id @default(uuid()) @db.Uuid
  profileId     String    @map("profile_id") @db.Uuid
  mode          String    @db.VarChar(20)
  title         String    @db.VarChar(160)
  filters       Json      @default("{}")
  questionCount Int       @map("question_count")
  status        String    @default("IN_PROGRESS") @db.VarChar(20)
  correctCount  Int?      @map("correct_count")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)

  profile   Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  questions StudySessionQuestion[]

  @@index([profileId, startedAt])
  @@map("study_sessions")
}

model StudySessionQuestion {
  sessionId  String @map("session_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  position   Int

  session  StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([sessionId, position])
  @@unique([sessionId, questionId])
  @@map("study_session_questions")
}

/// What a student may use (premium question bank, a course). Granted by an admin
/// now; by paid orders and subscriptions (Mercado Pago webhooks) later.
/// Active = starts_at <= now < ends_at (or no end) and not revoked.
model Entitlement {
  id                 String    @id @default(uuid()) @db.Uuid
  profileId          String    @map("profile_id") @db.Uuid
  kind               String    @db.VarChar(30)
  courseId           String?   @map("course_id") @db.Uuid
  startsAt           DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime? @map("ends_at") @db.Timestamptz(6)
  source             String    @db.VarChar(30)
  sourceId           String?   @map("source_id") @db.Uuid
  grantedByProfileId String?   @map("granted_by_profile_id") @db.Uuid
  note               String?   @db.VarChar(300)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  profile   Profile  @relation("EntitlementOwner", fields: [profileId], references: [id], onDelete: Cascade)
  grantedBy Profile? @relation("EntitlementGrantor", fields: [grantedByProfileId], references: [id], onDelete: SetNull)
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([profileId, kind])
  @@map("entitlements")
}

/// Daily answers of signed-out visitors (freemium: 1 per day). Keys are HMAC
/// hashes of a random cookie id and of the IP — never the raw values.
model VisitorAnswerUsage {
  keyHash   String   @map("key_hash") @db.Char(64)
  day       DateTime @db.Date
  answers   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([keyHash, day])
  @@index([day])
  @@map("visitor_answer_usage")
}

/// Something sold in the store (a plan, an exam combo). Grants entitlements when paid.
model Offer {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @unique @db.VarChar(120)
  name           String   @db.VarChar(160)
  headline       String?  @db.VarChar(240)
  description    String   @default("") @db.Text
  priceCents     Int      @map("price_cents")
  compareAtCents Int?     @map("compare_at_cents")
  isActive       Boolean  @default(false) @map("is_active")
  isFeatured     Boolean  @default(false) @map("is_featured")
  sortOrder      Int      @default(0) @map("sort_order")
  /// Wide banner for the home page carousel (optional).
  bannerAssetId  String?  @map("banner_asset_id") @db.Uuid
  /// Promotional price (price_cents) ends at this moment; afterwards the offer
  /// sells at compare_at_cents (the regular price) automatically.
  promoEndsAt    DateTime? @map("promo_ends_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  banner    MediaAsset?  @relation(fields: [bannerAssetId], references: [id], onDelete: SetNull)
  grants    OfferGrant[]
  orders    Order[]
  blogPosts BlogPost[]
  contests  Contest[]

  @@index([isActive, sortOrder])
  @@map("offers")
}

/// What an offer grants: premium question bank for N days, a course (later).
model OfferGrant {
  id           String  @id @default(uuid()) @db.Uuid
  offerId      String  @map("offer_id") @db.Uuid
  kind         String  @db.VarChar(30)
  courseId     String? @map("course_id") @db.Uuid
  /// null = no end date.
  durationDays Int?    @map("duration_days")

  offer  Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([offerId])
  @@map("offer_grants")
}

/// A purchase. Paid only when the payment provider confirms it (never the checkout redirect).
model Order {
  id                   String    @id @default(uuid()) @db.Uuid
  profileId            String    @map("profile_id") @db.Uuid
  offerId              String    @map("offer_id") @db.Uuid
  status               String    @default("PENDING") @db.VarChar(20)
  amountCents          Int       @map("amount_cents")
  currency             String    @default("BRL") @db.Char(3)
  offerSnapshot        Json      @map("offer_snapshot")
  provider             String    @default("MERCADO_PAGO") @db.VarChar(30)
  providerPreferenceId String?   @map("provider_preference_id") @db.VarChar(120)
  providerPaymentId    String?   @unique @map("provider_payment_id") @db.VarChar(60)
  providerStatus       String?   @map("provider_status") @db.VarChar(40)
  paidAt               DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([profileId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

/// A course of the member area (videos, PDFs, texts, question lists), sold through offers.
model Course {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(120)
  title        String   @db.VarChar(160)
  subtitle     String?  @db.VarChar(240)
  description  String   @default("") @db.Text
  coverAssetId String?  @map("cover_asset_id") @db.Uuid
  isPublished  Boolean  @default(false) @map("is_published")
  sortOrder    Int      @default(0) @map("sort_order")
  /// "Teoria Completa" generated from a position's edital verticalizado.
  syllabusId   String?  @map("syllabus_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cover         MediaAsset?          @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)
  syllabus      ContestSyllabus?     @relation(fields: [syllabusId], references: [id], onDelete: SetNull)
  modules       CourseModule[]
  offerGrants   OfferGrant[]
  entitlements  Entitlement[]
  readingStates CourseReadingState[]

  @@index([syllabusId])
  @@map("courses")
}

model CourseModule {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  title    String @db.VarChar(160)
  position Int

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  @@index([courseId, position])
  @@map("course_modules")
}

/// A lesson: TEXT (markdown body), PDF (private file), VIDEO (allow-listed embed URL), QUESTIONS (curated list).
model CourseLesson {
  id              String   @id @default(uuid()) @db.Uuid
  moduleId        String   @map("module_id") @db.Uuid
  title           String   @db.VarChar(160)
  kind            String   @db.VarChar(20)
  position        Int
  body            String   @default("") @db.Text
  videoEmbedUrl   String?  @map("video_embed_url") @db.VarChar(500)
  pdfAssetId      String?  @map("pdf_asset_id") @db.Uuid
  durationMinutes Int?     @map("duration_minutes")
  isFreePreview   Boolean  @default(false) @map("is_free_preview")
  /// Topic of the edital verticalizado this lesson teaches (checklist and practice questions).
  syllabusTopicId String?  @map("syllabus_topic_id") @db.Uuid
  /// EMPTY (to write), DRAFT (written, e.g. by AI, awaiting review), REVIEWED (checked by a person).
  contentStatus   String   @default("EMPTY") @map("content_status") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  module        CourseModule            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  pdf           MediaAsset?             @relation(fields: [pdfAssetId], references: [id], onDelete: SetNull)
  syllabusTopic ContestSyllabusTopic?   @relation(fields: [syllabusTopicId], references: [id], onDelete: SetNull)
  questions     CourseLessonQuestion[]
  progress      CourseLessonProgress[]
  annotations   CourseLessonAnnotation[]
  readingStates CourseReadingState[]

  @@index([moduleId, position])
  @@index([syllabusTopicId])
  @@map("course_lessons")
}

/// A student's highlight in a lesson text, optionally with a note. The quote is
/// found again by its text and a few characters around it (prefix/suffix).
model CourseLessonAnnotation {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  lessonId  String   @map("lesson_id") @db.Uuid
  quote     String   @db.VarChar(1000)
  prefix    String   @default("") @db.VarChar(64)
  suffix    String   @default("") @db.VarChar(64)
  note      String?  @db.VarChar(2000)
  color     String   @default("yellow") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lesson  CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([profileId, lessonId])
  @@map("course_lesson_annotations")
}

/// Where the student stopped in a course ("continuar de onde parei").
model CourseReadingState {
  profileId     String   @map("profile_id") @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  lessonId      String   @map("lesson_id") @db.Uuid
  scrollPercent Int      @default(0) @map("scroll_percent") @db.SmallInt
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  course  Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson  CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([profileId, courseId])
  @@map("course_reading_states")
}

model CourseLessonQuestion {
  lessonId   String @map("lesson_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  position   Int

  lesson   CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([lessonId, questionId])
  @@index([lessonId, position])
  @@map("course_lesson_questions")
}

model CourseLessonProgress {
  profileId   String   @map("profile_id") @db.Uuid
  lessonId    String   @map("lesson_id") @db.Uuid
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  profile Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lesson  CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([profileId, lessonId])
  @@map("course_lesson_progress")
}

model BlogCategory {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(120)
  /// CARREIRA (Policial, Fiscal…), EXAME (OAB, ENEM…) or GERAL.
  groupKey    String   @default("GERAL") @map("group_key") @db.VarChar(20)
  icon        String?  @db.VarChar(30)
  description String?  @db.VarChar(300)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  posts    BlogPost[]
  contests Contest[]

  @@map("blog_categories")
}

/// News / articles about public exams (SEO). Visible when PUBLISHED and published_at <= now (scheduling).
model BlogPost {
  id              String    @id @default(uuid()) @db.Uuid
  slug            String    @unique @db.VarChar(160)
  title           String    @db.VarChar(200)
  excerpt         String    @db.VarChar(320)
  body            String    @db.Text
  status          String    @default("DRAFT") @db.VarChar(20)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  categoryId      String?   @map("category_id") @db.Uuid
  coverAssetId    String?   @map("cover_asset_id") @db.Uuid
  authorProfileId String?   @map("author_profile_id") @db.Uuid
  relatedOfferId  String?   @map("related_offer_id") @db.Uuid
  relatedBoardId  String?   @map("related_board_id") @db.Uuid
  /// NEWS (notícia) or ARTICLE (guia / dica de estudo).
  format          String    @default("NEWS") @db.VarChar(20)
  /// Brazilian state of the news (null = nacional).
  stateCode       String?   @map("state_code") @db.Char(2)
  isFeatured      Boolean   @default(false) @map("is_featured")
  /// The contest the news is about (optional).
  contestId       String?   @map("contest_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  contest      Contest?        @relation(fields: [contestId], references: [id], onDelete: SetNull)
  category     BlogCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cover        MediaAsset?     @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)
  author       Profile?        @relation(fields: [authorProfileId], references: [id], onDelete: SetNull)
  relatedOffer Offer?          @relation(fields: [relatedOfferId], references: [id], onDelete: SetNull)
  relatedBoard ExaminingBoard? @relation(fields: [relatedBoardId], references: [id], onDelete: SetNull)
  images       BlogPostImage[]

  @@index([status, publishedAt])
  @@index([categoryId, publishedAt])
  @@index([stateCode, publishedAt])
  @@index([isFeatured, publishedAt])
  @@index([contestId, publishedAt])
  @@map("blog_posts")
}

/// Images used inside a post body ("[imagem N]" = position N).
model BlogPostImage {
  postId       String @map("post_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  position     Int

  post       BlogPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([postId, position])
  @@map("blog_post_images")
}

/// Blog newsletter sign-ups (LGPD: explicit consent time; unsubscribe keeps the row).
model NewsletterSubscriber {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(254)
  source         String    @default("blog") @db.VarChar(60)
  consentAt      DateTime  @default(now()) @map("consent_at") @db.Timestamptz(6)
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("newsletter_subscribers")
}

/// A public exam ("concurso") followed by the editorial team. Facts (vacancies, salaries, dates)
/// come from the official notice; the summary is written by us. Public only when is_published.
model Contest {
  id                String    @id @default(uuid()) @db.Uuid
  slug              String    @unique @db.VarChar(160)
  /// Display name, e.g. "Concurso PMPE 2027".
  name              String    @db.VarChar(200)
  organizationName  String    @map("organization_name") @db.VarChar(200)
  organizationId    String?   @map("organization_id") @db.Uuid
  boardId           String?   @map("board_id") @db.Uuid
  /// Career editorial (blog category of group CARREIRA / EXAME).
  careerCategoryId  String?   @map("career_category_id") @db.Uuid
  /// null = nacional.
  stateCode         String?   @map("state_code") @db.Char(2)
  /// EXPECTED, AUTHORIZED, NOTICE_PUBLISHED, REGISTRATION_OPEN, REGISTRATION_CLOSED, EXAM_DONE, FINISHED.
  status            String    @default("EXPECTED") @db.VarChar(30)
  vacancies         Int?
  hasReserveList    Boolean   @default(false) @map("has_reserve_list")
  salaryMinCents    Int?      @map("salary_min_cents")
  salaryMaxCents    Int?      @map("salary_max_cents")
  /// FUNDAMENTAL, MEDIO, SUPERIOR.
  educationLevels   String[]  @default([]) @map("education_levels") @db.VarChar(20)
  positions         String    @default("") @db.VarChar(1000)
  summary           String    @default("") @db.Text
  registrationStart DateTime? @map("registration_start") @db.Date
  registrationEnd   DateTime? @map("registration_end") @db.Date
  examDate          DateTime? @map("exam_date") @db.Date
  /// Official notice (https).
  noticeUrl         String?   @map("notice_url") @db.VarChar(500)
  /// Registration fee as in the notice, e.g. "R$ 150,00" or "R$ 90,00 a R$ 200,00".
  feeText           String?   @map("fee_text") @db.VarChar(120)
  /// Exam stages, one per line (objetiva, discursiva, TAF…).
  stages            String    @default("") @db.VarChar(2000)
  examLocations     String?   @map("exam_locations") @db.VarChar(300)
  /// Authorization act, e.g. "Portaria MGI nº 5.508/2026".
  authorization     String?   @db.VarChar(300)
  relatedOfferId    String?   @map("related_offer_id") @db.Uuid
  /// Logo / coat of arms of the organization (optional; shown on the cards).
  logoAssetId       String?   @map("logo_asset_id") @db.Uuid
  isFeatured        Boolean   @default(false) @map("is_featured")
  isPublished       Boolean   @default(false) @map("is_published")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     PublicOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  board            ExaminingBoard?     @relation(fields: [boardId], references: [id], onDelete: SetNull)
  careerCategory   BlogCategory?       @relation(fields: [careerCategoryId], references: [id], onDelete: SetNull)
  relatedOffer     Offer?              @relation(fields: [relatedOfferId], references: [id], onDelete: SetNull)
  logo             MediaAsset?         @relation(fields: [logoAssetId], references: [id], onDelete: SetNull)
  posts            BlogPost[]
  contestPositions ContestPosition[]
  syllabi          ContestSyllabus[]

  @@index([isPublished, status])
  @@index([isPublished, isFeatured])
  @@index([stateCode])
  @@map("contests")
}

/// Recurring Premium (Mercado Pago preapproval). Access comes only from approved charges
/// (subscription_payments → entitlements with source SUBSCRIPTION), never from this row alone.
model Subscription {
  id                     String    @id @default(uuid()) @db.Uuid
  profileId              String    @map("profile_id") @db.Uuid
  provider               String    @default("MERCADOPAGO") @db.VarChar(20)
  /// Mercado Pago preapproval id (set right after creation).
  providerSubscriptionId String?   @unique @map("provider_subscription_id") @db.VarChar(80)
  planKey                String    @map("plan_key") @db.VarChar(40)
  amountCents            Int       @map("amount_cents")
  currency               String    @default("BRL") @db.Char(3)
  /// PENDING (checkout not finished), AUTHORIZED, PAUSED, CANCELLED.
  status                 String    @default("PENDING") @db.VarChar(20)
  providerStatus         String?   @map("provider_status") @db.VarChar(40)
  nextChargeAt           DateTime? @map("next_charge_at") @db.Timestamptz(6)
  cancelledAt            DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile  Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  payments SubscriptionPayment[]

  @@index([profileId, status])
  @@map("subscriptions")
}

/// One recurring charge (Mercado Pago authorized payment). Grants one period of Premium once, when approved.
model SubscriptionPayment {
  id                String    @id @default(uuid()) @db.Uuid
  subscriptionId    String    @map("subscription_id") @db.Uuid
  /// Mercado Pago authorized_payment id.
  providerPaymentId String    @unique @map("provider_payment_id") @db.VarChar(80)
  /// Mercado Pago payment id of the charge, when there is one.
  paymentId         String?   @map("payment_id") @db.VarChar(40)
  /// PENDING, PAID, FAILED, REFUNDED.
  status            String    @default("PENDING") @db.VarChar(20)
  providerStatus    String?   @map("provider_status") @db.VarChar(40)
  amountCents       Int       @map("amount_cents")
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_payments")
}

/// A position (cargo) of a contest, with its own vacancies, salary and requirements.
model ContestPosition {
  id             String  @id @default(uuid()) @db.Uuid
  contestId      String  @map("contest_id") @db.Uuid
  name           String  @db.VarChar(200)
  vacancies      Int?
  hasReserveList Boolean @default(false) @map("has_reserve_list")
  salaryCents    Int?    @map("salary_cents")
  /// FUNDAMENTAL, MEDIO or SUPERIOR.
  educationLevel String? @map("education_level") @db.VarChar(20)
  requirements   String  @default("") @db.VarChar(500)
  sortOrder      Int     @default(0) @map("sort_order")

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@index([contestId, sortOrder])
  @@map("contest_positions")
}

/// "Edital verticalizado" of one position of a contest: subjects, number of
/// questions and the numbered topics of the official syllabus. Kept apart from
/// ContestPosition (positions are replaced as a whole on every contest save).
model ContestSyllabus {
  id              String   @id @default(uuid()) @db.Uuid
  contestId       String   @map("contest_id") @db.Uuid
  /// Position name as in the notice ("Soldado (Praça QPMG)").
  title           String   @db.VarChar(160)
  /// Unique within the contest; used in the public URL.
  slug            String   @db.VarChar(80)
  essayPoints     Int?     @map("essay_points")
  durationMinutes Int?     @map("duration_minutes")
  notes           String   @default("") @db.VarChar(2000)
  isPublished     Boolean  @default(false) @map("is_published")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contest  Contest                  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  subjects ContestSyllabusSubject[]
  courses  Course[]

  @@unique([contestId, slug])
  @@index([contestId, sortOrder])
  @@map("contest_syllabi")
}

model ContestSyllabusSubject {
  id            String  @id @default(uuid()) @db.Uuid
  syllabusId    String  @map("syllabus_id") @db.Uuid
  name          String  @db.VarChar(160)
  questionCount Int?    @map("question_count")
  block         String? @db.VarChar(40)
  /// Matching discipline of the controlled taxonomy (never created from here).
  disciplineId  String? @map("discipline_id") @db.Uuid
  /// Optional narrower link inside that discipline (e.g. História > História de Pernambuco).
  areaId        String? @map("area_id") @db.Uuid
  topicId       String? @map("topic_id") @db.Uuid
  sortOrder     Int     @default(0) @map("sort_order")

  syllabus   ContestSyllabus        @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  discipline Discipline?            @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  area       Area?                  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  topic      Topic?                 @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topics     ContestSyllabusTopic[]

  @@index([syllabusId, sortOrder])
  @@index([disciplineId])
  @@map("contest_syllabus_subjects")
}

model ContestSyllabusTopic {
  id        String  @id @default(uuid()) @db.Uuid
  subjectId String  @map("subject_id") @db.Uuid
  code      String? @db.VarChar(20)
  text      String  @db.VarChar(600)
  sortOrder Int     @default(0) @map("sort_order")

  subject  ContestSyllabusSubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  progress StudySyllabusProgress[]
  lessons  CourseLesson[]

  @@index([subjectId, sortOrder])
  @@map("contest_syllabus_topics")
}

/// A topic of an "edital verticalizado" the student marked as studied.
model StudySyllabusProgress {
  profileId String   @map("profile_id") @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  studiedAt DateTime @default(now()) @map("studied_at") @db.Timestamptz(6)

  profile Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  topic   ContestSyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([profileId, topicId])
  @@index([topicId])
  @@map("study_syllabus_progress")
}
